# WorkMate 配置（本地开发用，复制本文件为 .env 后按需修改；.env 已被 .gitignore 排除）
# 本文件不含任何密钥（本地模型免费，无需 API Key）

# 授权数据目录：放你的 xlsx/csv 销售表
WORKMATE_DATA_DIR=./data

# 成品目录：报告、图表、汇总表输出到这里
WORKMATE_OUTPUT_DIR=./outputs

# 模型提供商：ollama（本地）| mock（无 Ollama 时的兜底，仅开发用）
WORKMATE_MODEL_PROVIDER=ollama

# Ollama 本地服务地址与模型名
WORKMATE_OLLAMA_HOST=http://localhost:11434
WORKMATE_OLLAMA_MODEL=qwen2.5:7b
